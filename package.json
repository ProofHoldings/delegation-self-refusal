{
  "name": "@proof-holdings/delegation-self-refusal",
  "version": "0.1.0",
  "description": "A delegated MCP server that refuses its own tool calls once its Proof of Delegation is revoked, suspended, or expired — self-enforcement, not consumer verification",
  "type": "module",
  "license": "MIT",
  "author": "proof.holdings <hello@proof.holdings> (https://proof.holdings)",
  "homepage": "https://proof.holdings",
  "repository": {
    "type": "git",
    "url": "https://github.com/ProofHoldings/delegation-self-refusal.git"
  },
  "bugs": {
    "email": "hello@proof.holdings",
    "url": "https://proof.holdings/support"
  },
  "keywords": [
    "proof-of-delegation",
    "delegation",
    "revocation",
    "mcp",
    "agent-card",
    "self-enforcement"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test"
  },
  "peerDependencies": {
    "zod": "^3.25 || ^4.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": false
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@types/node": "^20.11.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@proof-holdings/delegation-verifier": "^0.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
